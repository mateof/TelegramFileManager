@page "/fm/{id}"

@using TelegramDownloader.Data
@using TelegramDownloader.Data.db
@using TelegramDownloader.Models
@using TelegramDownloader.Pages.Modals.InfoModals
@using TelegramDownloader.Pages.Partials
@using TelegramDownloader.Services
@inject IFileService fs
@inject ITelegramService ts
@inject ILogger<FileManager> Logger
@inject IJSRuntime JSRuntime;
@inject NavigationManager MyNavigationManager;
@implements IDisposable

<style>
    .e-filemanager .e-splitter {
    height: 75vh !important;
    }

    .e-filemanager {
    height: 80vh !important;
    }
</style>

<h3>
    <i class="bi bi-folder2-open me-2"></i>File Manager
    <Dropdown Color="DropdownColor.Secondary">
        <DropdownToggleButton>@chatName</DropdownToggleButton>
        <DropdownMenu>
            <DropdownItem @onclick="exportData" Type="DropdownItemType.Button"><i class="bi bi-cloud-download"></i> Export</DropdownItem>
            <DropdownItem @onclick="importData" Type="DropdownItemType.Button"><i class="bi bi-cloud-upload"></i> Import</DropdownItem>
            @if (canShowRefresh)
            {
                @if (isRefreshing)
                {
                    <DropdownItem Type="DropdownItemType.Button" Disabled="true">
                        <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Small" Class="me-2" />
                        Refreshing...
                    </DropdownItem>
                }
                else if (showRefresh)
                {
                    <DropdownItem @onclick="showRefreshConfirmation" Type="DropdownItemType.Button">
                        <span class="position-relative badge rounded-pill bg-danger">
                            Beta
                            <span class="visually-hidden">Beta function</span>
                        </span>
                        <i class="bi bi-arrow-clockwise"></i> Refresh data
                    </DropdownItem>
                }
            }

            <DropdownDivider />
            <DropdownItem @onclick="openDeleteChannelModal" Type="DropdownItemType.Button" Class="text-danger">
                <i class="bi bi-trash"></i> Delete Database
            </DropdownItem>
        </DropdownMenu>
    </Dropdown>
    <Button Color="ButtonColor.Info" class="ms-3" @onclick="openWebDavInfo"><i class="bi bi-hdd-network"></i> WebDav</Button>

</h3>

@if (isRefreshing && refreshProgress != null)
{
    <div class="card mb-3">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Small" />
                <strong>@RefreshPhaseText</strong>
                <small class="text-muted">since @refreshProgress.StartedAt.ToString("HH:mm:ss")</small>
                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="cancelRefresh" disabled="@refreshProgress.CancelRequested">
                    @if (refreshProgress.CancelRequested)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span><span>Canceling...</span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle me-1"></i><span>Cancel</span>
                    }
                </button>
            </div>
            <div class="row g-2 mt-1">
                @foreach (var f in refreshProgress.Filters)
                {
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="d-flex justify-content-between small">
                            <span><i class="bi @FilterIcon(f.Filter) me-1"></i>@FilterLabel(f.Filter)</span>
                            <span class="text-muted">@FilterCountText(f)</span>
                        </div>
                        <div class="progress" style="height: 6px;" role="progressbar" aria-label="@FilterLabel(f.Filter)">
                            <div class="progress-bar @(f.Done ? "bg-success" : "progress-bar-striped progress-bar-animated")" style="width: @(FilterPercent(f))%"></div>
                        </div>
                    </div>
                }
            </div>
            @if (refreshProgress.Phase != RefreshPhase.Searching)
            {
                <div class="mt-2">
                    <div class="d-flex justify-content-between small">
                        <span><i class="bi bi-database-add me-1"></i>Indexing new files</span>
                        <span class="text-muted">@refreshProgress.Indexed.ToString("N0") / @refreshProgress.NewFiles.ToString("N0")</span>
                    </div>
                    <div class="progress" style="height: 6px;" role="progressbar" aria-label="Indexing">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @(IndexPercent)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<ul class="nav nav-tabs">
    <li class="nav-item">
        <a class="nav-link active" aria-current="page" href="@($"/fm/{id}")">Remote</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="@($"/localfm/{id}")">Local</a>
    </li>
</ul>

<TelegramDownloader.Pages.Partials.impl.FileManagerImpl @ref="fileManagerImpl" id="@id"></TelegramDownloader.Pages.Partials.impl.FileManagerImpl>
<TelegramDownloader.Pages.Modals.ImportDataModal id="@id" @ref="ImportModal"></TelegramDownloader.Pages.Modals.ImportDataModal><TelegramDownloader.Pages.Modals.InfoModals.DeleteChannelModal @ref="deleteChannelModal" ChannelId="@id" ChannelName="@chatName"></TelegramDownloader.Pages.Modals.InfoModals.DeleteChannelModal>
<TelegramDownloader.Pages.Modals.InfoModals.MediaUrlModal @ref="webDavModal" title="WebDav URL" url="@webDavUrl"></TelegramDownloader.Pages.Modals.InfoModals.MediaUrlModal>

<TelegramDownloader.Pages.Modals.ConfirmationModal @ref="refreshConfirmModal"
    Title="Refresh Channel Data"
    Icon="bi-arrow-clockwise"
    ConfirmText="Refresh"
    ConfirmIcon="bi-arrow-clockwise"
    ProcessingText="Refreshing..."
    Size="TelegramDownloader.Pages.Modals.ConfirmationModal.ConfirmationSize.Large"
    Type="TelegramDownloader.Pages.Modals.ConfirmationModal.ConfirmationType.Warning"
    OnConfirm="executeRefreshData">
    <div class="mb-3">
        <p>Refresh data for <strong>@chatName</strong>. Select which media types to fetch:</p>
    </div>

    <div class="refresh-options mb-3">
        <div class="row g-2">
            <div class="col-6">
                <div class="form-check refresh-option-card @(refreshOptions.IncludeDocuments ? "selected" : "")">
                    <input class="form-check-input" type="checkbox" id="chkDocuments"
                           @bind="refreshOptions.IncludeDocuments" />
                    <label class="form-check-label" for="chkDocuments">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Documents</span>
                        <small>PDF, ZIP, etc.</small>
                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check refresh-option-card @(refreshOptions.IncludeAudio ? "selected" : "")">
                    <input class="form-check-input" type="checkbox" id="chkAudio"
                           @bind="refreshOptions.IncludeAudio" />
                    <label class="form-check-label" for="chkAudio">
                        <i class="bi bi-music-note-beamed"></i>
                        <span>Audio</span>
                        <small>MP3, music files</small>
                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check refresh-option-card @(refreshOptions.IncludeVideo ? "selected" : "")">
                    <input class="form-check-input" type="checkbox" id="chkVideo"
                           @bind="refreshOptions.IncludeVideo" />
                    <label class="form-check-label" for="chkVideo">
                        <i class="bi bi-camera-video"></i>
                        <span>Video</span>
                        <small>MP4, video files</small>
                    </label>
                </div>
            </div>
            <div class="col-6">
                <div class="form-check refresh-option-card @(refreshOptions.IncludePhotos ? "selected" : "")">
                    <input class="form-check-input" type="checkbox" id="chkPhotos"
                           @bind="refreshOptions.IncludePhotos" />
                    <label class="form-check-label" for="chkPhotos">
                        <i class="bi bi-image"></i>
                        <span>Photos</span>
                        <small>JPG, PNG images</small>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info py-2 px-3 mb-0" style="font-size: 0.85rem;">
        <i class="bi bi-info-circle me-2"></i>
        Only new files will be added. Existing files won't be duplicated.
    </div>

    <style>
        .refresh-option-card {
            background: var(--bs-tertiary-bg);
            border: 2px solid var(--bs-border-color);
            border-radius: 0.5rem;
            padding: 0.75rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .refresh-option-card:hover {
            border-color: var(--bs-primary);
            background: var(--bs-primary-bg-subtle);
        }
        .refresh-option-card.selected {
            border-color: var(--bs-primary);
            background: var(--bs-primary-bg-subtle);
        }
        .refresh-option-card .form-check-input {
            float: right;
            margin-top: 0.25rem;
        }
        .refresh-option-card label {
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
            cursor: pointer;
            width: 100%;
        }
        .refresh-option-card label i {
            font-size: 1.25rem;
            color: var(--bs-primary);
        }
        .refresh-option-card label span {
            font-weight: 600;
            font-size: 0.9rem;
        }
        .refresh-option-card label small {
            color: var(--bs-secondary-color);
            font-size: 0.75rem;
        }
    </style>
</TelegramDownloader.Pages.Modals.ConfirmationModal>

@code {
    private Modals.ImportDataModal ImportModal { get; set; }
    private TelegramDownloader.Pages.Partials.impl.FileManagerImpl fileManagerImpl { get; set; } = default!;
    private Modals.ConfirmationModal refreshConfirmModal { get; set; } = default!;
    [Parameter]
    public string id { get; set; }
    private DeleteChannelModal deleteChannelModal { get; set; } = default!;
    private MediaUrlModal webDavModal { get; set; } = default!;
    private string webDavUrl = "";

    BsonSharedInfoModel bsi { get; set; }
    public string chatName { get; set; }
    private bool isMyChannel = true;
    private bool showRefresh = true;
    private bool isRefreshing = false;

    // Refresh options
    private RefreshChannelOptions refreshOptions = new RefreshChannelOptions();

    // Show refresh button if: not my channel OR (is my channel AND EnableRefreshOwnChannels is enabled)
    private bool canShowRefresh => !isMyChannel || GeneralConfigStatic.config.EnableRefreshOwnChannels;

    NotificationModel nm = new NotificationModel();


    private string _previousId;

    // Live refresh progress, polled from the service while a refresh of this
    // channel runs (whoever started it: this page, another tab or the API).
    private ChannelRefreshProgressSnapshot? refreshProgress;
    private CancellationTokenSource? progressPollCts;
    private static readonly TimeSpan ProgressPollInterval = TimeSpan.FromSeconds(1);

    protected override async Task OnParametersSetAsync()
    {
        if (_previousId != id)
        {
            _previousId = id;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isRefreshing = fs.isChannelRefreshing(id);
            showRefresh = !isRefreshing;
            refreshProgress = isRefreshing ? fs.getChannelRefreshProgress(id) : null;
            if (isRefreshing)
                startProgressPolling();
            else
                stopProgressPolling();
            long channelId = Convert.ToInt64(id);
            chatName = ts.getChatName(channelId);
            isMyChannel = ts.isMyChat(channelId);

        } catch(Exception ex)
        {
            Logger.LogError(ex, "Error on GetSharedInfoById");
            nm.sendMessage("Error", "Error on GetSharedInfoById", NotificationTypes.Error);
        }
    }

    /// <summary>
    /// Builds the WebDAV URL for the current channel and folder and shows it in a
    /// copyable modal (e.g. to paste into a Synology Hyper Backup task).
    /// </summary>
    public async Task openWebDavInfo()
    {
        var folder = fileManagerImpl?.GetCurrentFolderPath() ?? "/";
        var suffix = string.Join("/", folder
            .Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Select(Uri.EscapeDataString));
        if (suffix.Length > 0) suffix += "/";
        webDavUrl = $"{MyNavigationManager.BaseUri}webdav/{id}/{suffix}";
        StateHasChanged();
        await webDavModal.OnShowModalClick();
    }

    public void exportData()
    {
        MyNavigationManager.NavigateTo("/api/file/export/" + id, true);
    }
    public async Task importData()
    {
        await ImportModal.Open();
    }

    private async Task showRefreshConfirmation()
    {
        refreshConfirmModal.Show();
    }

    private async Task executeRefreshData()
    {
        if (!refreshOptions.HasAnySelection)
        {
            nm.sendMessage("Warning", "Please select at least one media type", NotificationTypes.Error);
            return;
        }

        // Runs in the background; the progress panel follows it and the
        // confirmation modal closes right away.
        if (!fs.tryStartChannelRefresh(id, false, refreshOptions, out Task refreshTask))
        {
            nm.sendMessage("Refresh channel files", "This channel is already being refreshed.", NotificationTypes.Warn);
        }
        else
        {
            _ = refreshTask.ContinueWith(
                t => Logger.LogError(t.Exception, "Background refresh of channel {Id} failed", id),
                TaskContinuationOptions.OnlyOnFaulted);
        }

        isRefreshing = true;
        showRefresh = false;
        refreshProgress = fs.getChannelRefreshProgress(id);
        startProgressPolling();
        await InvokeAsync(StateHasChanged);
    }

    private void cancelRefresh()
    {
        if (fs.cancelChannelRefresh(id))
            refreshProgress = fs.getChannelRefreshProgress(id) ?? refreshProgress;
    }

    private void startProgressPolling()
    {
        stopProgressPolling();
        CancellationTokenSource cts = new CancellationTokenSource();
        progressPollCts = cts;
        _ = pollProgressAsync(id, cts.Token);
    }

    private void stopProgressPolling()
    {
        progressPollCts?.Cancel();
        progressPollCts?.Dispose();
        progressPollCts = null;
    }

    // Once a second at most: the counters move on every Telegram page, but
    // re-rendering on each would flood the circuit for no visible benefit.
    private async Task pollProgressAsync(string channelId, CancellationToken token)
    {
        try
        {
            using PeriodicTimer timer = new PeriodicTimer(ProgressPollInterval);
            while (await timer.WaitForNextTickAsync(token))
            {
                if (channelId != id) return;
                ChannelRefreshProgressSnapshot? snapshot = fs.getChannelRefreshProgress(channelId);
                if (snapshot != null)
                {
                    await InvokeAsync(() =>
                    {
                        refreshProgress = snapshot;
                        StateHasChanged();
                    });
                    continue;
                }

                // Finished (or canceled): show the outcome in the file list.
                await InvokeAsync(async () =>
                {
                    refreshProgress = null;
                    isRefreshing = false;
                    showRefresh = true;
                    StateHasChanged();
                    if (fileManagerImpl != null)
                        await fileManagerImpl.RefreshFileManager();
                });
                return;
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Polling the refresh progress of channel {Id} failed", channelId);
        }
    }

    private string RefreshPhaseText => refreshProgress?.Phase switch
    {
        RefreshPhase.Searching => "Refreshing: searching Telegram...",
        RefreshPhase.Indexing => "Refreshing: indexing new files...",
        _ => "Refreshing: finishing..."
    };

    private static string FilterLabel(RefreshFilter filter) => filter switch
    {
        RefreshFilter.Documents => "Documents",
        RefreshFilter.Audio => "Audio",
        RefreshFilter.Video => "Video",
        _ => "Photos"
    };

    private static string FilterIcon(RefreshFilter filter) => filter switch
    {
        RefreshFilter.Documents => "bi-file-earmark-text",
        RefreshFilter.Audio => "bi-music-note-beamed",
        RefreshFilter.Video => "bi-camera-video",
        _ => "bi-image"
    };

    private static string FilterCountText(RefreshFilterProgressSnapshot f)
    {
        if (f.Done) return $"{f.Fetched:N0} new messages read";
        return f.Total.HasValue ? $"{f.Fetched:N0} / {f.Total.Value:N0}" : $"{f.Fetched:N0}";
    }

    // An incremental scan stops long before Telegram's channel-wide total, so a
    // finished filter is shown full.
    private static int FilterPercent(RefreshFilterProgressSnapshot f)
    {
        if (f.Done) return 100;
        if (!f.Total.HasValue || f.Total.Value <= 0) return 0;
        return (int)Math.Clamp(f.Fetched * 100L / f.Total.Value, 0, 100);
    }

    private int IndexPercent => refreshProgress == null || refreshProgress.NewFiles <= 0
        ? (refreshProgress?.Phase == RefreshPhase.Done ? 100 : 0)
        : (int)Math.Clamp(refreshProgress.Indexed * 100L / refreshProgress.NewFiles, 0, 100);

    public void Dispose()
    {
        stopProgressPolling();
    }

    public async Task openDeleteChannelModal()
    {
        await deleteChannelModal.ShowAsync();
    }
}
