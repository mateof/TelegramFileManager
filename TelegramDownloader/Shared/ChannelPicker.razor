@* Multi-select of channels with a search box, for settings that hold a list of channel ids. *@
<div class="channel-picker" style="width: 100%; max-width: 420px;">
    <input type="text" class="form-control form-control-sm mb-1" placeholder="@Placeholder"
           value="@filter" @oninput="e => filter = e.Value?.ToString() ?? string.Empty" />
    <div style="max-height: 220px; overflow-y: auto; border: 1px solid var(--bs-border-color, #dee2e6); border-radius: .375rem; padding: .25rem .5rem;">
        @foreach (var channel in Filtered)
        {
            var isSelected = Selected.Contains(channel.Id);
            <label class="d-flex align-items-center gap-2" style="cursor: pointer; padding: 2px 0; margin: 0;">
                <input type="checkbox" class="form-check-input m-0" checked="@isSelected"
                       @onchange="e => Toggle(channel.Id, e.Value is bool b && b)" />
                <span class="text-truncate" title="@channel.Id">@channel.Name</span>
                <small class="text-muted ms-auto">@channel.Id</small>
            </label>
        }
        @if (!Filtered.Any())
        {
            <small class="text-muted">@(Channels.Count == 0 ? "No indexed channels" : "No channel matches")</small>
        }
    </div>
    <div class="d-flex justify-content-between align-items-center mt-1">
        <small class="text-muted">@Selected.Count selected</small>
        @if (Selected.Count > 0)
        {
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="Clear">Clear</button>
        }
    </div>
</div>

@code {
    public record ChannelOption(long Id, string Name);

    [Parameter] public List<ChannelOption> Channels { get; set; } = new();
    [Parameter] public List<long> Selected { get; set; } = new();
    [Parameter] public EventCallback<List<long>> SelectedChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search channels…";

    private string filter = string.Empty;

    private IEnumerable<ChannelOption> Filtered => Channels
        .Where(c => string.IsNullOrWhiteSpace(filter)
            || c.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || c.Id.ToString().Contains(filter))
        .OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase);

    private async Task Toggle(long id, bool on)
    {
        var next = new List<long>(Selected);
        if (on) { if (!next.Contains(id)) next.Add(id); }
        else next.Remove(id);
        Selected = next;
        await SelectedChanged.InvokeAsync(next);
    }

    private async Task Clear()
    {
        Selected = new List<long>();
        await SelectedChanged.InvokeAsync(Selected);
    }
}
